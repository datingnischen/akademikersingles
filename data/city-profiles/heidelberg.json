  "clusters": [
    {
      "name": "Life Sciences & Biotechnologie",
      "text": "Der Technologiepark Heidelberg im Neuenheimer Feld, das Biotech-Cluster BioRN und die Health + Life Science Alliance Heidelberg Mannheim verbinden Grundlagenforschung und Unternehmen."
    },
    {
      "name": "Medizin & Gesundheit",
      "text": "Universitätsklinikum und Medizinische Fakultät sind zusammen mit der Universität der größte Arbeitgeber der Stadt; das Nationale Centrum für Tumorerkrankungen (NCT) ist ein onkologisches Spitzenzentrum."
    },
    {
      "name": "Spitzenforschung",
      "text": "Das Deutsche Krebsforschungszentrum, das Europäische Laboratorium für Molekularbiologie (EMBL) und vier Max-Planck-Institute ziehen Forschende aus aller Welt an."
    },
    {
      "name": "IT, KI & Digitales",
      "text": "Im Heidelberg Innovation Park auf dem früheren Gelände der Patton Barracks arbeiten Start-ups und etablierte Unternehmen an KI, Software und Bioinformatik; dazu hat der Analytics-Softwarekonzern SAS seine deutsche Zentrale in Heidelberg."
    },
    {
      "name": "Industrie & Weltmarktführer",
      "text": "Heidelberg Materials hat seine Konzernzentrale in der Stadt, dazu kommen mittelständische Weltmarktführer wie Lamy, ProMinent und Tinti."
    },
    {
      "name": "Kultur- & Kreativwirtschaft",
      "text": "Musikwirtschaft, Buchmarkt, Kunstmarkt und darstellende Künste: Die Stadt fördert Neugründungen in der Kultur- und Kreativwirtschaft gezielt."
    }
  ],
